Executable nour = {
	.root     = "nour-cli/main.c",
	.sources  = {
		"nour-core/*.c",
		"nour-cli/*.c",
	},

	.includes = { "include", ".", "nour-core", "nour-cli" },
	.defines  = { "_POSIX_C_SOURCE=200809L" },
	.cflags   = {
		"-O2",
		"-Wall",
		"-Wextra",
		"-std=c11",
	},
	.ldflags  = { "-ldl" },
};

Project Nour = {
	.version   = "0.1.0",
	.build_dir = "bin",
	.targets   = { &nour },
};
